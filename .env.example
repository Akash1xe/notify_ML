APP_NAME=Notify
APP_ENV=development
HOST=127.0.0.1
PORT=8000
STORAGE_ROOT=storage/jobs
JOB_RETENTION_HOURS=72
MAX_CONCURRENT_JOBS=2
LOG_LEVEL=INFO
PROCESSOR_MODE=document
VIDEO_MAX_HEIGHT=1080
VIDEO_PREFERRED_CONTAINER=mp4
MAX_VIDEO_DOWNLOAD_GB=4
VIDEO_DOWNLOAD_RETRIES=3
VIDEO_FRAGMENT_RETRIES=3
DOWNLOAD_DISK_SAFETY_MARGIN_MB=512
FFMPEG_PATH=
FFPROBE_PATH=
MEDIA_PROBE_TIMEOUT_SECONDS=30
AUDIO_EXTRACTION_TIMEOUT_MULTIPLIER=3
AUDIO_DISK_SAFETY_MARGIN_MB=256
AUDIO_DURATION_TOLERANCE_RATIO=0.01

# Phase 3 - frame sampling
FRAME_SAMPLE_FPS=1.0
FRAME_SAMPLE_MAX_FPS=5.0
MAX_SAMPLED_FRAMES=20000
FRAME_ESTIMATED_SIZE_KB=150
FRAME_DISK_SAFETY_MARGIN_MB=512
FRAME_SAMPLING_TIMEOUT_MULTIPLIER=2
FRAME_SAMPLING_BASE_TIMEOUT_SECONDS=120
FRAME_JPEG_QUALITY=90

# Phase 3 - preprocessing
ANALYSIS_FRAME_WIDTH=640
MAX_INVALID_FRAME_RATIO=0.02
DARK_FRAME_THRESHOLD=0.05
BLACK_PIXEL_VALUE_THRESHOLD=10
BLACK_PIXEL_RATIO_THRESHOLD=0.95
BLUR_VARIANCE_THRESHOLD=50
LOW_INFORMATION_EDGE_DENSITY=0.01
LOW_INFORMATION_CONTRAST=0.04

# Phase 3 - difference scoring
DIFF_PIXEL_WEIGHT=0.25
DIFF_SSIM_WEIGHT=0.35
DIFF_PHASH_WEIGHT=0.20
DIFF_EDGE_WEIGHT=0.20
DIFF_PHASH_SIZE=8
DIFF_CANNY_LOW=100
DIFF_CANNY_HIGH=200
MAX_INVALID_COMPARISON_RATIO=0.02

# Phase 3 - major transitions
MAJOR_CHANGE_MIN_SCORE=0.30
VERY_MAJOR_CHANGE_MIN_SCORE=0.60
MAJOR_CHANGE_ROBUST_MULTIPLIER=6
MAJOR_CHANGE_MERGE_WINDOW_SECONDS=2
MAX_MAJOR_EVENT_RATIO_WARNING=0.30

# Phase 3 - temporal timeline
TIMELINE_STABLE_MIN_SCORE=0.03
TIMELINE_STABLE_MAX_SCORE=0.10
TIMELINE_STABLE_ROBUST_MULTIPLIER=1.5
TIMELINE_EXIT_STABLE_FACTOR=1.6
MIN_STABLE_DURATION_SECONDS=2
MIN_CHANGING_DURATION_SECONDS=1
MAX_STABLE_GAP_SECONDS=0.5

# Phase 4.1 - stability windows
STABILITY_WINDOW_MIN_DURATION_SECONDS=2
STABILITY_MAX_INVALID_FRAME_RATIO=0.10
STABILITY_MAX_BLACK_FRAME_RATIO=0.20
STABILITY_DURATION_SATURATION_SECONDS=10
STABILITY_DIFFERENCE_WEIGHT=0.55
STABILITY_VARIANCE_WEIGHT=0.15
STABILITY_MAX_SPIKE_WEIGHT=0.15
STABILITY_DURATION_WEIGHT=0.15

# Phase 4.2 - stable boundaries
BOUNDARY_CONTEXT_SECONDS=4
BOUNDARY_MIN_ACTIVITY_DROP=0.10
BOUNDARY_MIN_SCORE=0.25
BOUNDARY_DURATION_SATURATION_SECONDS=10
BOUNDARY_DROP_WEIGHT=0.40
BOUNDARY_STABILITY_WEIGHT=0.25
BOUNDARY_QUALITY_WEIGHT=0.20
BOUNDARY_DURATION_WEIGHT=0.10
BOUNDARY_TYPE_WEIGHT=0.05

# Phase 4.3 - candidate generation
CANDIDATE_SETTLE_DELAY_SECONDS=1.0
CANDIDATE_EXIT_MARGIN_SECONDS=0.75
MIN_CANDIDATE_SPACING_SECONDS=1.0
MAX_CANDIDATES_PER_WINDOW=5
CANDIDATE_FRAME_SEARCH_RADIUS_SECONDS=1.5
ALLOW_WINDOW_ONLY_CANDIDATES=true
MAX_TOTAL_CANDIDATES=1000

# Phase 4.4 - candidate heuristics
CANDIDATE_SHARPNESS_SATURATION=200
CANDIDATE_LOCAL_CONTEXT_SECONDS=1.5
CANDIDATE_TRANSITION_SAFE_MARGIN_SECONDS=1.0
COMPLETENESS_BOUNDARY_WEIGHT=0.20
COMPLETENESS_STABILITY_WEIGHT=0.18
COMPLETENESS_ACTIVITY_WEIGHT=0.14
COMPLETENESS_ACCUMULATION_WEIGHT=0.14
COMPLETENESS_DENSITY_WEIGHT=0.10
COMPLETENESS_POSITION_WEIGHT=0.08
COMPLETENESS_QUALITY_WEIGHT=0.08
COMPLETENESS_SAFETY_WEIGHT=0.08

# Phase 4.5 - ranking and selection
RANK_QUALITY_WEIGHT=0.22
RANK_COMPLETENESS_WEIGHT=0.28
RANK_SAFETY_WEIGHT=0.18
RANK_LOCAL_STABILITY_WEIGHT=0.14
RANK_BOUNDARY_WEIGHT=0.08
RANK_DENSITY_WEIGHT=0.06
RANK_ACCUMULATION_WEIGHT=0.04
TOP_CANDIDATES_PER_WINDOW=2
MIN_PRIMARY_RANKING_SCORE=0.0
MIN_ALTERNATE_RANKING_SCORE=0.25
AMBIGUOUS_RANKING_GAP=0.05
RANKING_TIE_EPSILON=0.000001


# Phase 5.1 - audio preparation
AUDIO_VIDEO_DURATION_TOLERANCE_SECONDS=3
AUDIO_VIDEO_DURATION_TOLERANCE_RATIO=0.01
AUDIO_MIN_DURATION_SECONDS=0.5
AUDIO_DIAGNOSTIC_WINDOW_SECONDS=1.0
AUDIO_SILENCE_RMS_THRESHOLD=0.003
AUDIO_EFFECTIVELY_SILENT_RATIO=0.98
AUDIO_HIGH_CLIPPING_RATIO=0.02
TRANSCRIPTION_CHUNK_SECONDS=600
TRANSCRIPTION_CHUNK_OVERLAP_SECONDS=3

# Phase 5.2 - faster-whisper
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=auto
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_WORD_TIMESTAMPS=true
WHISPER_TEMPERATURE=0
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
WHISPER_CHUNK_MAX_RETRIES=1
WHISPER_MODEL_CACHE_DIR=
MAX_CONCURRENT_TRANSCRIPTIONS=1

# Phase 5.3 - normalization
TRANSCRIPT_OVERLAP_TIME_TOLERANCE_SECONDS=4
TRANSCRIPT_DUPLICATE_SIMILARITY_THRESHOLD=0.85
TRANSCRIPT_MERGE_MAX_GAP_SECONDS=0.75
TRANSCRIPT_MAX_SEGMENT_DURATION_SECONDS=20
TRANSCRIPT_MAX_SEGMENT_CHARACTERS=400
TRANSCRIPT_SHORT_SEGMENT_MAX_DURATION_SECONDS=1.5

# Phase 5.4 - alignment
ALIGNMENT_TIMESTAMP_EPSILON_SECONDS=0.05
ALIGNMENT_PROXIMITY_SATURATION_SECONDS=10
ALIGNMENT_WORD_LEVEL_ENABLED=true

# Phase 5.5 - context extraction
TRANSCRIPT_CONTEXT_BEFORE_SECONDS=12
TRANSCRIPT_CONTEXT_AFTER_SECONDS=8
TRANSCRIPT_CONTEXT_MAX_BOUNDARY_EXTENSION_SECONDS=3
TRANSCRIPT_CONTEXT_MAX_CHARACTERS=4000
TRANSCRIPT_CONTEXT_MAX_WORDS=500
TRANSCRIPT_CONTEXT_MIN_WORDS_FOR_NON_SPARSE=8


# Phase 6.1 - semantic input
SEMANTIC_INPUT_MAX_CONTEXT_CHARACTERS=5000

# Phase 6.2 - Qwen3-VL runtime
QWEN_VL_MODEL_TIER=4b
QWEN_VL_MODEL_NAME=
QWEN_VL_FALLBACK_MODEL_TIER=2b
QWEN_VL_ENABLE_FALLBACK=true
QWEN_VL_DEVICE=auto
QWEN_VL_DTYPE=auto
QWEN_VL_QUANTIZATION=none
QWEN_VL_MODEL_CACHE_DIR=
QWEN_VL_LOCAL_FILES_ONLY=false
QWEN_VL_MODEL_REVISION=
QWEN_VL_MAX_NEW_TOKENS=512
QWEN_VL_MAX_IMAGES_PER_REQUEST=3
QWEN_VL_MAX_IMAGE_LONG_EDGE=1280
MAX_CONCURRENT_VLM_INFERENCES=1

# Phase 6.3 - temporal visual context
TEMPORAL_CONTEXT_PREVIOUS_MAX_SECONDS=12
TEMPORAL_CONTEXT_NEXT_MAX_SECONDS=12
TEMPORAL_CONTEXT_MIN_FRAME_GAP_SECONDS=1.5
TEMPORAL_CONTEXT_PREFERRED_FRAME_GAP_SECONDS=3
TEMPORAL_CONTEXT_MIN_VISUAL_DIFFERENCE=0.03
TEMPORAL_CONTEXT_DUPLICATE_DIFFERENCE_THRESHOLD=0.015

# Phase 6.4 - semantic analysis
SEMANTIC_PROMPT_MAX_CHARACTERS=10000
SEMANTIC_INVALID_OUTPUT_RETRIES=1
SEMANTIC_FAILED_RESULT_RETRY_ON_RESUME=true

# Phase 6.5 - semantic decisions
SEMANTIC_DECISION_COMPLETION_WEIGHT=0.28
SEMANTIC_DECISION_USEFULNESS_WEIGHT=0.24
SEMANTIC_DECISION_SETTLED_WEIGHT=0.16
SEMANTIC_DECISION_CONFIDENCE_WEIGHT=0.12
SEMANTIC_DECISION_TRANSCRIPT_WEIGHT=0.08
SEMANTIC_DECISION_PHASE4_WEIGHT=0.12
MIN_SEMANTIC_DECISION_SCORE=0.55
MIN_SEMANTIC_CONFIDENCE=0.35
SEMANTIC_ALTERNATE_SWITCH_MARGIN=0.05
SEMANTIC_PRIMARY_TIE_BONUS=0.01
SEMANTIC_DECISION_AMBIGUITY_GAP=0.04
SEMANTIC_TRANSITION_REJECT_THRESHOLD=0.70


# Phase 7.1 - exact high-resolution source screenshots
FINAL_SCREENSHOT_FORMAT=png
SOURCE_SCREENSHOT_END_TOLERANCE_SECONDS=0.05
SOURCE_SCREENSHOT_MIN_DIMENSION=32
SOURCE_SCREENSHOT_TIMEOUT_SECONDS=120
MAX_CONCURRENT_SCREENSHOT_EXTRACTIONS=1

# Phase 7.2 - quality validation and bounded timestamp refinement
SCREENSHOT_SHARPNESS_SATURATION=250
SCREENSHOT_BLUR_SCORE_THRESHOLD=0.18
SCREENSHOT_MIN_QUALITY_SCORE=0.50
SCREENSHOT_GOOD_QUALITY_SCORE=0.68
SCREENSHOT_QUALITY_SEARCH_RADIUS_SECONDS=0.40
SCREENSHOT_QUALITY_SEARCH_STEP_SECONDS=0.10
MAX_SCREENSHOT_QUALITY_ATTEMPTS=9
SCREENSHOT_SEARCH_ON_ACCEPTABLE=false
SCREENSHOT_TIMESTAMP_DISTANCE_WEIGHT=0.05
SCREENSHOT_MIN_QUALITY_IMPROVEMENT_TO_SHIFT=0.03
SCREENSHOT_QUALITY_SHARPNESS_WEIGHT=0.30
SCREENSHOT_QUALITY_CONTRAST_WEIGHT=0.20
SCREENSHOT_QUALITY_EXPOSURE_WEIGHT=0.20
SCREENSHOT_QUALITY_CONTENT_WEIGHT=0.20
SCREENSHOT_QUALITY_BLANKNESS_WEIGHT=0.10

# Phase 7.3 - final screenshot visual fingerprints
VISUAL_PHASH_SIZE=8
VISUAL_DHASH_SIZE=8
VISUAL_COMPARISON_LONG_EDGE=320
VISUAL_EDGE_LOW_THRESHOLD=80
VISUAL_EDGE_HIGH_THRESHOLD=180
MAX_CONCURRENT_FINGERPRINT_JOBS=2

# Phase 7.4 - cross-window duplicate detection
DUPLICATE_PRIMARY_TEMPORAL_WINDOW_SECONDS=120
DUPLICATE_FULL_PAIRWISE_CUTOFF=150
DUPLICATE_HASH_BUCKET_SLICES=4
DUPLICATE_STRUCTURAL_WEIGHT=0.35
DUPLICATE_EDGE_WEIGHT=0.25
DUPLICATE_PHASH_WEIGHT=0.20
DUPLICATE_DHASH_WEIGHT=0.10
DUPLICATE_CONTENT_WEIGHT=0.05
DUPLICATE_TEMPORAL_WEIGHT=0.05
DUPLICATE_SCORE_THRESHOLD=0.88
POSSIBLE_DUPLICATE_SCORE_THRESHOLD=0.78
DUPLICATE_MIN_STRUCTURAL_SIMILARITY=0.86
DUPLICATE_MIN_EDGE_SIMILARITY=0.72
DUPLICATE_MAX_STRUCTURAL_ADDITION_RATIO=0.22
DUPLICATE_CHANGED_PIXEL_THRESHOLD=0.08
DUPLICATE_LONG_RANGE_PHASH_DISTANCE=0.12

# Phase 7.5 - deterministic duplicate-group winner selection
FINAL_SELECTION_SEMANTIC_WEIGHT=0.35
FINAL_SELECTION_QUALITY_WEIGHT=0.30
FINAL_SELECTION_COMPLETION_WEIGHT=0.15
FINAL_SELECTION_CONFIDENCE_WEIGHT=0.08
FINAL_SELECTION_SHARPNESS_WEIGHT=0.07
FINAL_SELECTION_TIMESTAMP_WEIGHT=0.05
FINAL_SELECTION_EXACT_TIMESTAMP_BONUS=0.01
FINAL_SELECTION_TIE_EPSILON=0.000001
FINAL_SELECTION_MAX_SEMANTIC_DEFICIT_FOR_QUALITY_OVERRIDE=0.15

# Phase 7.7 - diagnostic thresholds only
PHASE7_HIGH_FALLBACK_RATIO=0.35
PHASE7_HIGH_DUPLICATE_RATIO=0.70
PHASE7_HIGH_QUALITY_OVERRIDE_RATIO=0.40
PHASE7_POOR_FINAL_QUALITY_RATIO=0.15

# Phase 8 - document input / layout / render / PDF
DOCUMENT_SQUARE_ASPECT_TOLERANCE=0.05
DOCUMENT_INCLUDE_TIMESTAMP_DISPLAY=true
DOCUMENT_INCLUDE_SOURCE_METADATA=true
PDF_PAGE_SIZE=A4
PDF_PAGE_ORIENTATION=AUTO
PDF_SQUARE_PAGE_ORIENTATION=PORTRAIT
PDF_MARGIN_TOP_MM=12
PDF_MARGIN_BOTTOM_MM=12
PDF_MARGIN_LEFT_MM=12
PDF_MARGIN_RIGHT_MM=12
PDF_HEADER_ENABLED=false
PDF_HEADER_HEIGHT_MM=8
PDF_FOOTER_ENABLED=true
PDF_FOOTER_HEIGHT_MM=8
PDF_CAPTION_ENABLED=true
PDF_CAPTION_HEIGHT_MM=10
PDF_ALLOW_IMAGE_UPSCALE=false
PDF_LAYOUT_EPSILON_POINTS=0.01
PDF_MIN_SCREENSHOT_WIDTH_MM=80
PDF_MIN_SCREENSHOT_HEIGHT_MM=45
PDF_SHOW_TIMESTAMP=true
PDF_SHOW_CONTENT_TYPE=false
PDF_CAPTION_MAX_CHARACTERS=300
PDF_CAPTION_MAX_WORDS=50
PDF_CAPTION_MAX_LINES=2
PDF_PAGE_NUMBER_STYLE=SIMPLE
PDF_HEADER_MAX_CHARACTERS=100
PDF_HEADER_FONT_SIZE_PT=10
PDF_CAPTION_FONT_SIZE_PT=9
PDF_FOOTER_FONT_SIZE_PT=8
PDF_IMAGE_COMPRESSION_MODE=AUTO
PDF_JPEG_QUALITY=92
PDF_RENDER_BOUNDS_EPSILON_POINTS=0.5
PDF_PAGE_DIMENSION_EPSILON_POINTS=0.5
PDF_LARGE_FILE_WARNING_MB=100
PDF_UNICODE_FONT_PATH=
DOCUMENT_DOWNLOAD_FILENAME_MAX_LENGTH=120
DOCUMENT_PREVIEW_ENABLED=true
FRONTEND_ORIGIN=http://localhost:5173
